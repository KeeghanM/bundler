{{ 'bundle-widget.css' | asset_url | stylesheet_tag }}

<div
  class="bundler-widget"
  style="--bundler-bg: {{ block.settings.bg_color }}; --bundler-text: {{ block.settings.text_color }}; --bundler-btn-bg: {{ block.settings.button_bg_color }}; --bundler-btn-text: {{ block.settings.button_text_color }}; --bundler-border-color: {{ block.settings.border_color }}; --bundler-success: {{ block.settings.success_color }}; --bundler-error: {{ block.settings.error_color }}; --bundler-border-radius: {{ block.settings.border_radius }}px; --bundler-shadow: {% if block.settings.show_shadow %}0 18px 42px rgba(18, 24, 38, 0.08){% else %}none{% endif %};"
  data-shop="{{ shop.permanent_domain | escape }}"
  data-api-base="/apps/bundler"
  data-mode="{{ block.settings.widget_mode | escape }}"
  data-eyebrow="{{ block.settings.eyebrow_text | escape }}"
  data-button-text="{{ block.settings.button_text | escape }}"
  data-loading-text="{{ block.settings.loading_text | escape }}"
  data-current-product-text="{{ block.settings.current_product_text | escape }}"
  data-success-text="{{ block.settings.success_text | escape }}"
  data-show-variant-selector="{{ block.settings.show_variant_selector }}"
  data-select-options-text="{{ block.settings.select_options_text | escape }}"
  data-add-to-unlock-text="{{ block.settings.add_to_unlock_text | escape }}"
  data-unlocked-text="{{ block.settings.unlocked_text | escape }}"
  data-discount-percentage-text="{{ block.settings.discount_percentage_text | escape }}"
  data-discount-fixed-text="{{ block.settings.discount_fixed_text | escape }}"
  data-success-js-callback="{{ block.settings.success_js_callback | escape }}"
  data-custom-card-html="{{ block.settings.custom_card_html | escape }}"
  data-product-id="gid://shopify/Product/{{ product.id }}"
  data-variant-id="gid://shopify/ProductVariant/{{ product.selected_or_first_available_variant.id }}"
  data-sku="{{ product.selected_or_first_available_variant.sku | escape }}"
  data-collection-ids='[{% for collection in product.collections %}"gid://shopify/Collection/{{ collection.id }}"{% unless forloop.last %},{% endunless %}{% endfor %}]'
>
  </div>

{% if block.settings.custom_css != blank %}
<style>
  {{ block.settings.custom_css }}
</style>
{% endif %}

<script src="{{ 'bundle-widget.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Bundle offer",
  "target": "section",
  "settings": [
    {
      "type": "select",
      "id": "widget_mode",
      "label": "Widget Mode",
      "options": [
        { "value": "dropdowns", "label": "Product Dropdowns" },
        { "value": "carousel", "label": "Product Carousel" },
        { "value": "message_only", "label": "Message Only" }
      ],
      "default": "dropdowns"
    },
    {
      "type": "checkbox",
      "id": "show_variant_selector",
      "label": "Show Variant Selector",
      "default": true
    },
    {
      "type": "text",
      "id": "select_options_text",
      "label": "Options Text",
      "default": "Select Options in Basket"
    },
    {
      "type": "header",
      "content": "Text Customization"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text",
      "default": "Bundle offer"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Add bundle to cart"
    },
    {
      "type": "text",
      "id": "loading_text",
      "label": "Button Loading Text",
      "default": "Adding bundle..."
    },
    {
      "type": "text",
      "id": "current_product_text",
      "label": "Current Product Selected Text",
      "default": "Current product selected for {groups}."
    },
    {
      "type": "text",
      "id": "add_to_unlock_text",
      "label": "Add Items To Unlock Text",
      "default": "Add {missing} to unlock."
    },
    {
      "type": "text",
      "id": "unlocked_text",
      "label": "Bundle Unlocked Text",
      "default": "{title} offers unlocked!"
    },
    {
      "type": "text",
      "id": "discount_percentage_text",
      "label": "Percentage Discount Text",
      "default": "{discount}% off qualifying items"
    },
    {
      "type": "text",
      "id": "discount_fixed_text",
      "label": "Fixed Amount Discount Text",
      "default": "{discount} off qualifying items"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success Message Text",
      "default": "Bundle added."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#181d27"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background",
      "default": "#155dfc"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "success_color",
      "label": "Success Text Color",
      "default": "#166534"
    },
    {
      "type": "color",
      "id": "error_color",
      "label": "Error Text Color",
      "default": "#b81c1c"
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#dde0e4"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Border Radius",
      "default": 18
    },
    {
      "type": "checkbox",
      "id": "show_shadow",
      "label": "Show shadow",
      "default": true
    },
    {
      "type": "header",
      "content": "Advanced: Custom Carousel HTML"
    },
    {
      "type": "paragraph",
      "content": "Use {image}, {title}, {price}, and {button} to customize how carousel items render. If left blank, the default unopinionated card is used."
    },
    {
      "type": "html",
      "id": "custom_card_html",
      "label": "Custom Product Card HTML"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Advanced: Custom CSS"
    },
    {
      "type": "textarea",
      "id": "success_js_callback",
      "label": "Advanced: Success Callback (JavaScript)"
    }
  ]
}
{% endschema %}
